<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AppNotas" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/verde_notas</item>
        <item name="colorPrimaryVariant">@color/verde_oscuro_notas</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Todos los botones de la app usan el estilo de Figma -->
        <item name="materialButtonStyle">@style/BotonNotas</item>
    </style>


    <!-- Botones como los de Material 3 en Figma: forma de píldora, verde y sin mayúsculas -->
    <style name="BotonNotas" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/verde_notas</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Botón elevado de la bienvenida (Toggle button - elevated en Figma) -->
    <style name="BotonElevado" parent="BotonNotas">
        <item name="backgroundTint">@color/verde_claro_notas</item>
        <item name="android:textColor">@color/verde_oscuro_notas</item>
        <item name="iconTint">@color/verde_oscuro_notas</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Botón secundario con borde (Editar en la nota aleatoria) -->
    <style name="BotonContorno" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/verde_oscuro_notas</item>
        <item name="strokeColor">@color/verde_notas</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Imagen recortada en círculo (la tortuga) -->
    <style name="ImagenRedonda">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>